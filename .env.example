# Supabase: en local, copia los valores que imprime `npm run db:start`.
# En producción, Supabase Dashboard → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Notificaciones push (claves VAPID). Genera un par con:
#   npx web-push generate-vapid-keys
# Usa claves distintas en local y en producción. La privada nunca va al cliente.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
